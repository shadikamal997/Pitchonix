const FULL_DOCUMENT = {
  id: 'test-document-id',
  userId: 'test-user-id',
  profileId: 'test-profile-id',
  title: 'Alexandra Chen - Product Management Executive',
  doctype: 'cv' as const,
  templateId: null,
  brandKitId: null,
  variant: null,
  createdAt: new Date().toISOString(),
  updatedAt: new Date().toISOString(),
  thumbnailUrl: null,
  lastExportUrl: null,
  content: {
    sectionOrder: ['header', 'summary', 'experience', 'education', 'skills', 'languages', 'certifications', 'projects', 'awards'] as CvSectionKey[]
  },
} as CvDocumentDto;

async function generateAllTemplates() {
  console.log('🚀 PHASE 42.24 — VISUAL CERTIFICATION');
  console.log('═══════════════════════════════════════════════\n');
  
  // Create output directory
  const outputDir = join(__dirname, 'exports', 'visual-cert-phase42-24');
  mkdirSync(outputDir, { recursive: true });
  
  console.log(`📁 Output directory: ${outputDir}\n`);
  console.log(`📊 Generating ${CV_TEMPLATE_LIBRARY.length} templates with full data...\n`);
  
  const results: Array<{
    name: string;
    category: string;
    doctype: string;
    success: boolean;
    size: number;
    error?: string;
  }> = [];
  
  for (const template of CV_TEMPLATE_LIBRARY) {
    try {
      console.log(`   Rendering: ${template.name} (${template.category})...`);
      
      const doc = {
        ...FULL_DOCUMENT,
        doctype: template.doctype,
        title: `${FULL_PROFILE.personal?.fullName} - ${template.name}`
      };
      
      const html = renderCvHtml(FULL_PROFILE as any, doc as any, template.layout as any);
      
      const filename = `${template.name.replace(/\s+/g, '-').toLowerCase()}.html`;
      const filepath = join(outputDir, filename);
      
      writeFileSync(filepath, html, 'utf-8');
      
      results.push({
        name: template.name,
        category: template.category,
        doctype: template.doctype,
        success: true,
        size: html.length
      });
      
      console.log(`   ✅ Generated: ${filename} (${(html.length / 1024).toFixed(1)} KB)`);
      
    } catch (error) {
      console.error(`   ❌ Failed: ${template.name} - ${error.message}`);
      results.push({
        name: template.name,
        category: template.category,
        doctype: template.doctype,
        success: false,
        size: 0,
        error: error.message
      });
    }
  }
  
  console.log('\n═══════════════════════════════════════════════');
  console.log('📊 GENERATION SUMMARY\n');
  
  const successCount = results.filter(r => r.success).length;
  const failCount = results.filter(r => !r.success).length;
  
  console.log(`✅ Successfully generated: ${successCount}`);
  console.log(`❌ Failed: ${failCount}`);
  console.log(`📄 Total templates: ${results.length}\n`);
  
  // Group by category
  const byCategory = results.reduce((acc, r) => {
    if (!acc[r.category]) acc[r.category] = [];
    acc[r.category].push(r);
    return acc;
  }, {} as Record<string, typeof results>);
  
  console.log('📁 BY CATEGORY:\n');
  Object.entries(byCategory).forEach(([category, templates]) => {
    console.log(`   ${category}: ${templates.length} templates`);
    templates.forEach(t => {
      const status = t.success ? '✅' : '❌';
      console.log(`      ${status} ${t.name}`);
    });
    console.log('');
  });
  
  // Save catalog
  const catalog = {
    generated: new Date().toISOString(),
    totalTemplates: results.length,
    successCount,
    failCount,
    byCategory,
    templates: results
  };
  
  const catalogPath = join(outputDir, '_CATALOG.json');
  writeFileSync(catalogPath, JSON.stringify(catalog, null, 2), 'utf-8');
  console.log(`\n📋 Catalog saved: ${catalogPath}`);
  
  console.log('\n═══════════════════════════════════════════════');
  console.log('✅ GENERATION COMPLETE');
  console.log(`📁 All files in: ${outputDir}`);
  console.log('\n🔍 Next steps:');
  console.log('   1. Open each HTML file in browser');
  console.log('   2. Score each template on 7 criteria');
  console.log('   3. Identify templates below 9/10');
  console.log('   4. Redesign failing templates');
  console.log('═══════════════════════════════════════════════\n');
}

// Run
generateAllTemplates().catch(console.error);
